# Generated by spring-boot-workflows ci-setup v{VERSION}
# Regenerate with /spring-boot-workflows:ci-setup --platform gitea
#
# Gitea Actions resolves bare action names against github.com. Every `uses:`
# below therefore carries the full https://gitea.com/... URL.
name: Java CI with Maven

on:
  push:
    branches: [{BRANCHES}]
  pull_request:
    branches: [{PR_BRANCHES}]

concurrency:
  group: ${{ gitea.workflow }}-${{ gitea.event.pull_request.number || gitea.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build & Test
    runs-on: {RUNNER}

    steps:
      - name: Checkout
        uses: https://gitea.com/actions/checkout@v7
        env:
          # Required only for private repositories; configure the GITEA_TOKEN secret.
          GITEA_TOKEN: ${{ secrets.GITEA_TOKEN }}

      - name: Set up JDK {JAVA_VERSION}
        uses: https://gitea.com/actions/setup-java@v6
        with:
          java-version: "{JAVA_VERSION}"
          distribution: temurin

      - name: Cache Maven Repository
        uses: https://gitea.com/actions/cache@v6
        with:
          path: {CACHE_PATH}
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-

      - name: Verify
        run: {MAVEN_CMD} -B verify {MAVEN_ARGS}

      - name: Upload Test Reports
        if: always()
        uses: https://gitea.com/actions/upload-artifact@v7
        with:
          name: test-reports
          path: target/surefire-reports/
          if-no-files-found: ignore
          retention-days: 7

      # >>> optional:coverage
      - name: Generate Coverage Report
        run: {MAVEN_CMD} -B jacoco:report {MAVEN_ARGS}

      - name: Upload Coverage Report
        if: always()
        uses: https://gitea.com/actions/upload-artifact@v7
        with:
          name: jacoco-report
          path: target/site/jacoco/
          if-no-files-found: ignore
          retention-days: 7
      # <<< optional:coverage

      # >>> optional:spotbugs
      - name: Static Analysis (SpotBugs)
        run: {MAVEN_CMD} -B spotbugs:check {MAVEN_ARGS}
      # <<< optional:spotbugs

      # >>> optional:artifact
      - name: Upload JAR
        uses: https://gitea.com/actions/upload-artifact@v7
        with:
          name: app
          path: {ARTIFACT_GLOB}
          if-no-files-found: error
          retention-days: 7
      # <<< optional:artifact
