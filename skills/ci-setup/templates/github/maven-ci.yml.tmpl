# Generated by spring-boot-workflows ci-setup v{VERSION}
# Regenerate with /spring-boot-workflows:ci-setup --platform github
name: Java CI with Maven

on:
  push:
    branches: [{BRANCHES}]
  pull_request:
    branches: [{PR_BRANCHES}]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build & Test
    runs-on: {RUNNER}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK {JAVA_VERSION}
        uses: actions/setup-java@v5
        with:
          java-version: "{JAVA_VERSION}"
          distribution: temurin

      - name: Cache Maven Repository
        uses: actions/cache@v4
        with:
          path: {CACHE_PATH}
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-

      - name: Verify
        run: {MAVEN_CMD} -B verify {MAVEN_ARGS}

      - name: Upload Test Reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: target/surefire-reports/
          if-no-files-found: ignore
          retention-days: 7

      # >>> optional:coverage
      - name: Generate Coverage Report
        run: {MAVEN_CMD} -B jacoco:report {MAVEN_ARGS}

      - name: Upload Coverage Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: jacoco-report
          path: target/site/jacoco/
          if-no-files-found: ignore
          retention-days: 7
      # <<< optional:coverage

      # >>> optional:spotbugs
      - name: Static Analysis (SpotBugs)
        run: {MAVEN_CMD} -B spotbugs:check {MAVEN_ARGS}
      # <<< optional:spotbugs

      # >>> optional:artifact
      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: app
          path: {ARTIFACT_GLOB}
          if-no-files-found: error
          retention-days: 7
      # <<< optional:artifact
